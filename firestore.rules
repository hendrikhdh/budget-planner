rules_version = '2';

// ─── Firestore Security Rules ─────────────────────────────────────────────────
// Jeder Nutzer darf ausschließlich sein eigenes Budget-Dokument lesen und
// schreiben. Alles, was hier nicht explizit erlaubt wird, ist automatisch
// verboten — eine zusätzliche "allow read, write: if false"-Regel wäre wirkungslos,
// weil mehrere allow-Statements ODER-verknüpft werden und ein Deny daher nie
// ein Allow überstimmen kann.
//
// Deployment:
//   firebase deploy --only firestore:rules
// Oder direkt in der Firebase Console unter Firestore → Rules einfügen.

service cloud.firestore {
  match /databases/{database}/documents {

    match /budgets/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // Bewusst EIN einziges write-Statement: stünde die Validierung in einem
      // zweiten allow-Block, würde sie nie greifen (ODER-Semantik).
      // - Dokument muss "data" (String) und "updatedAt" (String) enthalten
      // - Größe grob auf 900.000 Zeichen begrenzt. size() zählt Zeichen, das
      //   Firestore-Limit sind Bytes — diese Regel ist daher nur ein Backstop
      //   gegen Missbrauch. Die exakte Byte-Prüfung macht der Client
      //   (DOC_MAX_BYTES in useFirestoreSync.js).
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(["data", "updatedAt"])
        && request.resource.data.data is string
        && request.resource.data.updatedAt is string
        && request.resource.data.data.size() <= 900000;
    }
  }
}
